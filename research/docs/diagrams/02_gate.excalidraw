    {"type":"text","id":"l4T","x":84,"y":472,"width":422,"height":64,"text":"LAYER 4 · Lean proof-term dependency + axiom audit\nthe ONLY place \"elementary\" is enforced\ndeterministic · non-gameable","originalText":"LAYER 4 · Lean proof-term dependency + axiom audit\nthe ONLY place \"elementary\" is enforced\ndeterministic · non-gameable","fontSize":15,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","strokeColor":"#b45309","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":2061,"version":1,"versionNonce":2061,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"l4","lineHeight":1.3},

