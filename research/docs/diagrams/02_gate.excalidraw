    {"type":"text","id":"insightT","x":596,"y":112,"width":340,"height":122,"text":"Lean-verified ≠ elementary\n\nMathlib IS the heavy machinery — a compiling\nproof can route through class groups or\nMihăilescu. So Layer 4 audits the PROOF TERM's\ndependency closure, not \"it compiled\".","originalText":"Lean-verified ≠ elementary\n\nMathlib IS the heavy machinery — a compiling\nproof can route through class groups or\nMihăilescu. So Layer 4 audits the PROOF TERM's\ndependency closure, not \"it compiled\".","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"middle","strokeColor":"#b91c1c","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":2071,"version":1,"versionNonce":2071,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"insight","lineHeight":1.3},

