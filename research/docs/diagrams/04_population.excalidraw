    {"type":"text","id":"evpuctT","x":714,"y":310,"width":367,"height":66,"text":"PUCT:  score(a) =\n   Q(a) + c*P(a)*sqrt(ln N) / (1 + N(a))\nexploit strength Q   +   explore (small N)","originalText":"PUCT:  score(a) =\n   Q(a) + c*P(a)*sqrt(ln N) / (1 + N(a))\nexploit strength Q   +   explore (small N)","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"middle","strokeColor":"#22c55e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":4081,"version":1,"versionNonce":4081,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"evpuct","lineHeight":1.4},

    {"type":"text","id":"foot","x":40,"y":404,"width":1055,"height":22,"text":"Search-efficiency only — none of this changes whether a proof is ACCEPTED (that is the elementary gate's job).","originalText":"Search-efficiency only — none of this changes whether a proof is ACCEPTED (that is the elementary gate's job).","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#64748b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":4090,"version":1,"versionNonce":4090,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25}
