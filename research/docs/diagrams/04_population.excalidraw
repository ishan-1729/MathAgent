    {"type":"text","id":"evestT","x":279,"y":310,"width":377,"height":66,"text":"Elo (online):  R += K*(S - E)\n   E = 1 / (1 + 10^((R_B - R_A)/400))\nBradley-Terry (batch MLE):  P(i>j) = s_i/(s_i + s_j)","originalText":"Elo (online):  R += K*(S - E)\n   E = 1 / (1 + 10^((R_B - R_A)/400))\nBradley-Terry (batch MLE):  P(i>j) = s_i/(s_i + s_j)","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"middle","strokeColor":"#22c55e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":4071,"version":1,"versionNonce":4071,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"evest","lineHeight":1.4},

