    {"type":"text","id":"lshared","x":700,"y":520,"width":230,"height":36,"text":"L1 and L2 both need L4 →\nsame goal_hash ⇒ ONE node (a DAG)","originalText":"L1 and L2 both need L4 →\nsame goal_hash ⇒ ONE node (a DAG)","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#047857","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":5074,"version":1,"versionNonce":5074,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},

