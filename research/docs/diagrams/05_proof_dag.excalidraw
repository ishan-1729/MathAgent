    {"type":"text","id":"ev2T","x":622,"y":684,"width":456,"height":74,"text":"goal key = SHA-256(NFC + whitespace statement identity)\nproof-context key binds policy + authority epoch\nmemo off or policy change → fresh attempt","originalText":"goal key = SHA-256(NFC + whitespace statement identity)\nproof-context key binds policy + authority epoch\nmemo off or policy change → fresh attempt","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"middle","strokeColor":"#22c55e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":5093,"version":2,"versionNonce":5093,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"ev2","lineHeight":1.45},

