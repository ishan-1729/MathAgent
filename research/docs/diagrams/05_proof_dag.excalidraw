    {"type":"text","id":"ev1T","x":122,"y":684,"width":444,"height":74,"text":"OR-node (goal):   direct   OR   one decomposition\nAND-node (decomp):  ALL children proven  ⇒  parent\nrecurse into children — depth-first, backtrack on fail","originalText":"OR-node (goal):   direct   OR   one decomposition\nAND-node (decomp):  ALL children proven  ⇒  parent\nrecurse into children — depth-first, backtrack on fail","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"middle","strokeColor":"#22c55e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":5091,"version":1,"versionNonce":5091,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"ev1","lineHeight":1.45},

