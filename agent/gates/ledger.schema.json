{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mathagent/ledger.schema.json",
  "title": "MathAgent proof step-ledger",
  "description": "A proof represented as a DAG of justified steps. See agent/PLAN.md Section 5 (Layer 1).",
  "type": "object",
  "additionalProperties": false,
  "required": ["problem", "claim", "steps"],
  "properties": {
    "problem": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "Identifier of the problem this ledger proves (e.g. a benchmarks/problems folder name)."
    },
    "claim": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "description": "The theorem statement the ledger establishes (mirrors the terminal step's claim)."
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": { "$ref": "#/definitions/step" }
    }
  },
  "definitions": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "claim", "justification", "depends_on"],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "description": "Unique step id within the ledger."
        },
        "claim": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536,
          "description": "The mathematical statement this step establishes."
        },
        "justification": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "A key from the allowed-toolkit vocabulary (agent/gates/allowed_toolkit.yaml). Validated against the loaded toolkit, not hard-coded here."
        },
        "depends_on": {
          "type": "array",
          "maxItems": 2000,
          "items": { "type": "string", "maxLength": 128 },
          "description": "Ids of steps used as premises (defines the proof DAG edges)."
        },
        "method_ref": {
          "type": "string",
          "maxLength": 4096,
          "description": "Optional path to a knowledge/methods/*.md file backing this step."
        },
        "obligations": {
          "$ref": "#/definitions/obligations"
        }
      }
    },
    "obligations": {
      "type": "object",
      "additionalProperties": false,
      "description": "Structured proof obligations a justification must discharge. The required shape depends on the justification's obligation kind (see allowed_toolkit.yaml). Unknown obligation keys are rejected.",
      "properties": {
        "case_cover": {
          "type": "object",
          "additionalProperties": false,
          "required": ["modulus", "residues"],
          "properties": {
            "modulus": { "type": "integer", "minimum": 2, "maximum": 10000 },
            "residues": {
              "type": "array",
              "maxItems": 10000,
              "items": { "type": "integer" },
              "description": "Residues (mod modulus) the case split enumerates; must cover a complete residue system."
            }
          }
        },
        "descent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["measure", "strictly_decreases", "stays_in_domain"],
          "properties": {
            "measure": { "type": "string", "maxLength": 10000, "description": "The well-founded measure expression, e.g. 'x'." },
            "strictly_decreases": { "type": "boolean" },
            "stays_in_domain": { "type": "boolean" },
            "measure_expr": { "type": "string", "maxLength": 10000, "description": "Optional: measure as an evaluable expression of the variables." },
            "next_expr": { "type": "string", "maxLength": 10000, "description": "Optional: the constructed smaller witness's measure expression, for a numeric decrease spot-check." },
            "variables": { "type": "array", "maxItems": 64, "items": { "type": "string", "maxLength": 128 } },
            "sample_bounds": {
              "type": "object",
              "maxProperties": 64,
              "additionalProperties": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 }
            }
          }
        },
        "bounding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inequality", "strict"],
          "properties": {
            "inequality": { "type": "string", "maxLength": 10000 },
            "strict": { "type": "boolean" }
          }
        },
        "split_coprimality": {
          "type": "object",
          "additionalProperties": false,
          "required": ["coprimality_from"],
          "properties": {
            "coprimality_from": { "type": "string", "maxLength": 128, "description": "Id of the prior step establishing the coprimality this square-split relies on." }
          }
        }
      }
    }
  }
}
